# Vite env (usar VITE_ para exponer al cliente)
# Copia a .env y rellena valores para producción o local.

# Monad RPC (mainnet). If you get 429 or timeouts, use an RPC URL with an API key (e.g. from Monad dashboard).
VITE_RPC_URL=https://rpc.monad.xyz

# Contratos en Monad Mainnet
VITE_FACTORY_ADDRESS=0xae6bF7d376374a4D28C78726d9Fdb27289CCF5f3
VITE_PAL_TOKEN_ADDRESS=0x0dfBc608339aeA55F5EEedE640335dAC062a7777

# Elemental & Ruleta (optional; leave empty if not deployed)
VITE_ELEMENTAL_FACTORY_ADDRESS=
VITE_RULETA_ADDRESS=

# ConnectKit / WalletConnect (opcional; sin esto el botón "Connect" puede dar aviso)
VITE_WALLETCONNECT_PROJECT_ID=
