# Monad RPC
RPC_URL=https://rpc.monad.xyz

# Operator wallet (mainnet)
OPERATOR_PRIVATE_KEY=0x...

# Deployed factory proxy address
FACTORY_ADDRESS=0xae6bF7d376374a4D28C78726d9Fdb27289CCF5f3

# PAL token address
PAL_TOKEN_ADDRESS=0x0dfBc608339aeA55F5EEedE640335dAC062a7777

# Scheduling
MATCH_INTERVAL=60
BETTING_WINDOW=60
AUTO_SETTLE_DELAY=5

# Rooster pool (comma-separated)
ROOSTERS=Phoenix,Dragon,Cyber-Falcon,Neon-Hawk

# Elemental & Ruleta (optional; leave empty if not deployed)
ELEMENTAL_FACTORY_ADDRESS=
RULETA_ADDRESS=

# Logging
LOG_LEVEL=info
